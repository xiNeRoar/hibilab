{
  "name": "hibilab-theme-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible Tailwind CSS and repository image builds for the HIBI LAB WordPress theme handoff.",
  "scripts": {
    "build": "npm run build:css && npm run build:images",
    "build:css": "node build-css.js",
    "build:images": "node scripts/build-images.js",
    "verify": "node scripts/verify-build.js && npm run verify:prototypes",
    "verify:prototypes": "node scripts/verify-prototypes.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "postcss": "8.5.23",
    "postcss-prefix-selector": "2.1.1",
    "sharp": "0.35.3",
    "tailwindcss": "3.4.19"
  }
}
